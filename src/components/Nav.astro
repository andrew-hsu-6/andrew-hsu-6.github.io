---
const navLinks = [
  { href: "/", label: "Home" },
  { href: "/projects", label: "Projects" },
  { href: "/about", label: "About" },
  { href: "/contact", label: "Contact" },
];

const currentPath = Astro.url.pathname;

function isActive(href: string) {
  if (href === "/") return currentPath === "/";
  return currentPath.startsWith(href);
}
---

<header class="sticky top-0 z-50 bg-cream/90 backdrop-blur-sm border-b border-charcoal/10">
  <nav class="max-w-3xl mx-auto flex items-center justify-between px-6 py-5">
    <a href="/" class="font-serif text-xl font-semibold text-charcoal">
      Andrew Hsu
    </a>
    <ul class="flex items-center gap-6 text-sm font-medium">
      {
        navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class:list={[
                "transition-colors hover:text-rust",
                isActive(link.href) ? "text-rust" : "text-charcoal-soft",
              ]}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
