<footer class="border-t border-charcoal/10 mt-24">
  <div class="max-w-3xl mx-auto px-6 py-10 flex flex-col sm:flex-row items-center justify-between gap-4">
    <p class="text-sm text-charcoal-soft">
      &copy; {new Date().getFullYear()} Andrew Hsu
    </p>
    <div class="flex items-center gap-5">
      {
        socials.map((social) => (
          <a
            href={social.href}
            aria-label={social.label}
            class="text-charcoal-soft hover:text-rust transition-colors"
            target={social.href.startsWith("mailto:") ? undefined : "_blank"}
            rel={social.href.startsWith("mailto:") ? undefined : "noopener noreferrer"}
          >
            <svg viewBox="0 0 24 24" class="w-5 h-5 fill-current">
              <path d={social.icon} />
            </svg>
          </a>
        ))
      }
    </div>
  </div>
</footer>
