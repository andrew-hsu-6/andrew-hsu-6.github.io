---
interface Props {
  name: string;
  description: string;
  tech: string[];
  github: string;
}

const { name, description, tech, github } = Astro.props;
---

<a
  href={github}
  target="_blank"
  rel="noopener noreferrer"
  class="group block rounded-2xl border border-charcoal/10 bg-cream-dark/40 p-6 hover:border-rust/40 hover:shadow-md transition-all"
>
  <div class="flex items-start justify-between gap-3">
    <h3 class="font-serif text-xl font-semibold text-charcoal group-hover:text-rust transition-colors">
      {name}
    </h3>
    <svg viewBox="0 0 24 24" class="w-5 h-5 mt-1 shrink-0 fill-none stroke-charcoal-soft group-hover:stroke-rust transition-colors">
      <path d="M7 17 17 7M7 7h10v10" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </div>
  <p class="mt-2 text-sm leading-relaxed text-charcoal-soft">{description}</p>
  <div class="mt-4 flex flex-wrap gap-2">
    {
      tech.map((t) => (
        <span class="text-xs font-medium rounded-full bg-charcoal/5 text-charcoal-soft px-3 py-1">
          {t}
        </span>
      ))
    }
  </div>
</a>
