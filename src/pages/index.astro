---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Home">
  <section class="max-w-3xl mx-auto px-6 pt-16 pb-20 sm:pt-24 sm:pb-28">
    <div class="flex flex-col-reverse sm:flex-row items-center sm:items-start gap-10">
      <div class="flex-1 text-center sm:text-left">
        <p class="font-serif italic text-rust text-lg mb-3">Hi, I'm</p>
        <h1 class="font-serif text-4xl sm:text-5xl font-semibold text-charcoal leading-tight">
          Andrew Hsu
        </h1>
        <p class="mt-4 text-lg text-charcoal-soft">
          CS student at Columbia University, building a second career in software engineering.
        </p>
        <p class="mt-6 text-base leading-relaxed text-charcoal-soft">
          I spent a few years as an investment analyst before deciding to pursue
          what I actually wanted to build: software. Now I'm at Columbia studying
          computer science, with a focus on full-stack development and machine
          learning &mdash; I like working on teams that ship products people
          actually use.
        </p>
        <div class="mt-8 flex items-center justify-center sm:justify-start gap-4">
          <a
            href="/projects"
            class="inline-flex items-center rounded-full bg-rust px-6 py-3 text-sm font-medium text-cream hover:bg-rust-dark transition-colors"
          >
            See my projects
          </a>
          <a
            href="/contact"
            class="inline-flex items-center rounded-full border border-charcoal/20 px-6 py-3 text-sm font-medium text-charcoal hover:border-rust hover:text-rust transition-colors"
          >
            Get in touch
          </a>
        </div>
      </div>
      <img
        src="/headshot.jpg"
        alt="Portrait of Andrew Hsu"
        class="w-36 h-36 sm:w-44 sm:h-44 rounded-full object-cover shadow-md shrink-0"
      />
    </div>
  </section>
</BaseLayout>
