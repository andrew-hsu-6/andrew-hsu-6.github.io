---
import BaseLayout from "../layouts/BaseLayout.astro";

const education = [
  {
    school: "Columbia University",
    years: "2025 – Present",
    degree: "Bachelor of Science in Computer Science",
  },
  {
    school: "The University of Texas at Austin",
    years: "2019 – 2023",
    degree: "Bachelor of Business Administration in Finance",
  },
];

const skills = [
  { category: "Languages", items: ["Java", "Python", "C"] },
  { category: "Tools", items: ["Docker", "Git", "uv", "Maven"] },
];
---

<BaseLayout title="About">
  <section class="max-w-3xl mx-auto px-6 py-16 sm:py-20">
    <h1 class="font-serif text-3xl sm:text-4xl font-semibold text-charcoal">
      About
    </h1>

    <div class="mt-6 space-y-4 text-charcoal-soft leading-relaxed">
      <p>
        I was formerly an investment analyst working in finance. Now I'm a
        student at Columbia University pursuing a career in software
        engineering. Feel free to connect with me as I begin my journey
        in a new field.
      </p>
      <p>
        I'm interested in full-stack development and machine learning.
        Specifically, I hope to work on teams that are building products and
        features used directly by clients.
      </p>
      <p>
        In my free time, I enjoy playing soccer and tennis, and picking up new
        things in general. My favorite soccer team is Chelsea, and my
        favorite tennis player is Carlos Alcaraz.
      </p>
    </div>

    <h2 class="mt-14 font-serif text-2xl font-semibold text-charcoal">
      Education
    </h2>
    <div class="mt-6 space-y-6">
      {
        education.map((entry) => (
          <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 border-b border-charcoal/10 pb-6">
            <div>
              <p class="font-medium text-charcoal">{entry.school}</p>
              <p class="text-sm text-charcoal-soft">{entry.degree}</p>
            </div>
            <p class="text-sm text-rust font-medium whitespace-nowrap">{entry.years}</p>
          </div>
        ))
      }
    </div>

    <h2 class="mt-14 font-serif text-2xl font-semibold text-charcoal">
      Skills
    </h2>
    <div class="mt-6 space-y-5">
      {
        skills.map((group) => (
          <div>
            <p class="text-sm font-medium text-charcoal-soft uppercase tracking-wide">
              {group.category}
            </p>
            <div class="mt-2 flex flex-wrap gap-2">
              {group.items.map((item) => (
                <span class="text-sm rounded-full bg-charcoal/5 text-charcoal px-3 py-1">
                  {item}
                </span>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>
