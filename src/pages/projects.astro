---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";

// TODO: replace with the real repo URLs for each project
const projects = [
  {
    name: "Pictolingo",
    description:
      "A language learning app that helps improve writing and reading Mandarin Chinese.",
    tech: ["React Native"],
    github: "https://github.com/andrew-hsu-6/pictolingo",
  },
  {
    name: "LionTalk",
    description: "An aggregator for Columbia speaker seminars.",
    tech: ["Python"],
    github: "https://github.com/andrew-hsu-6/liontalk",
  },
  {
    name: "ResyBot",
    description: "Automates restaurant bookings for hard-to-get tables.",
    tech: ["Java"],
    github: "https://github.com/andrew-hsu-6/resybot",
  },
];
---

<BaseLayout title="Projects">
  <section class="max-w-3xl mx-auto px-6 py-16 sm:py-20">
    <h1 class="font-serif text-3xl sm:text-4xl font-semibold text-charcoal">
      Projects
    </h1>
    <p class="mt-3 text-charcoal-soft">
      A few things I've built while learning to write software.
    </p>
    <div class="mt-10 grid gap-5 sm:grid-cols-2">
      {projects.map((project) => <ProjectCard {...project} />)}
    </div>
  </section>
</BaseLayout>
