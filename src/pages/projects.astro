---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";

const projects = [
  {
    name: "LionTalk",
    description:
      "A centralized hub for upcoming Columbia speaker events, scraped and normalized daily with Gemini.",
    tech: ["Python", "Gemini API"],
    link: "https://liontalk.vercel.app/",
  },
  {
    name: "Calordle",
    description:
      "A daily Wordle-style calorie guessing game, with a progressive hint system and shareable results.",
    tech: ["Next.js", "TypeScript", "PostgreSQL"],
  },
  {
    name: "ResyBot",
    description:
      "Automated monitoring tool that polls for hard-to-get restaurant reservations.",
    tech: ["Java", "Docker"],
    link: "https://github.com/LionDevelopers/ResyBot",
  },
];
---

<BaseLayout title="Projects">
  <section class="max-w-3xl mx-auto px-6 py-16 sm:py-20">
    <h1 class="font-serif text-3xl sm:text-4xl font-semibold text-charcoal">
      Projects
    </h1>
    <p class="mt-3 text-charcoal-soft">
      Things I've built and shipped.
    </p>
    <div class="mt-10 grid gap-5 sm:grid-cols-2">
      {projects.map((project) => <ProjectCard {...project} />)}
    </div>
  </section>
</BaseLayout>
